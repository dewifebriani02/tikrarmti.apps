# Database (PostgreSQL on the VPS) — DATABASE_URL, or the DB_* parts
DATABASE_URL=postgresql://mti_user:password@127.0.0.1:5432/mti_db

# Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3006

# Production (uncomment and update for production)
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://www.markaztikrar.id

# Google reCAPTCHA v3 (for security)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here


# Auth (required) — JWT signing secret, min 32 chars. Generate: openssl rand -base64 48
AUTH_SECRET=your_long_random_secret_here

# Cron (required for /api/cron/*) — min 32 chars. Send as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=your_long_random_cron_secret_here

# Email via Resend (required for password reset emails)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="MTI <noreply@markaztikrar.id>"

# WhatsApp Integration (Meta Cloud API & WatZap)
WHATSAPP_CLOUD_API_TOKEN=your_meta_system_user_or_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_WABA_ID=your_meta_waba_account_id_here
WATZAP_API_KEY=your_watzap_api_key_here
WATZAP_NUMBER_KEY=your_watzap_number_key_here
